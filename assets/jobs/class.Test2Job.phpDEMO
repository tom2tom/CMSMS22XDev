<?php

namespace CMSAsset\jobs; //OR CMSMS\assets\jobs if the folder name is definite

use CMSMS\Async\Job;

class Test2Job extends Job
{
    public function __construct()
    {
        parent::__construct();
        $this->name = 'Test2Job';
        $this->start = strtotime('+1 hour',time());
        //etc
    }

    public function execute($time = 0)
    {
        if( !$time ) { $time = time(); }
        $this->record_exec_time($time);
        if( $this->start > $time ) return true;
        $this->force_start = $time;
//      some_unktimen_function(); // intentionally generate an error
        \audit('','Assets Job','Test2 complete');
        \debug_to_log('Job Test2 complete');
        return true;
    }
}
